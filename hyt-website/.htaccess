# HYT Engineering – Apache configuration (generated by src/build.py)
# Requires mod_rewrite, mod_headers, mod_expires and mod_deflate (standard on cPanel hosting).

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
AddDefaultCharset UTF-8
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType video/webm .webm
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest

ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/de-de/#">
    ErrorDocument 404 /de-de/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/fr-fr/#">
    ErrorDocument 404 /fr-fr/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/it-it/#">
    ErrorDocument 404 /it-it/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/nl-nl/#">
    ErrorDocument 404 /nl-nl/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/en-us/#">
    ErrorDocument 404 /en-us/404.html
</If>

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Force HTTPS and the canonical host (no www) – uncomment after TLS is live.
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://hytengineering.com%{REQUEST_URI} [R=301,L,NE]

# 2. Permanent redirects from the Redirects tab of the sitemap workbook (all six language folders).
RewriteRule ^cnc\-surface\-wheel\-lathe/?$ /surface-wheel-lathe/ [R=301,L,NC]
RewriteRule ^de\-de/cnc\-surface\-wheel\-lathe/?$ /de-de/surface-wheel-lathe/ [R=301,L,NC]
RewriteRule ^fr\-fr/cnc\-surface\-wheel\-lathe/?$ /fr-fr/surface-wheel-lathe/ [R=301,L,NC]
RewriteRule ^it\-it/cnc\-surface\-wheel\-lathe/?$ /it-it/surface-wheel-lathe/ [R=301,L,NC]
RewriteRule ^nl\-nl/cnc\-surface\-wheel\-lathe/?$ /nl-nl/surface-wheel-lathe/ [R=301,L,NC]
RewriteRule ^en\-us/cnc\-surface\-wheel\-lathe/?$ /en-us/surface-wheel-lathe/ [R=301,L,NC]
RewriteRule ^cnc\-underfloor\-wheel\-lathe/?$ /underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^de\-de/cnc\-underfloor\-wheel\-lathe/?$ /de-de/underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^fr\-fr/cnc\-underfloor\-wheel\-lathe/?$ /fr-fr/underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^it\-it/cnc\-underfloor\-wheel\-lathe/?$ /it-it/underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^nl\-nl/cnc\-underfloor\-wheel\-lathe/?$ /nl-nl/underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^en\-us/cnc\-underfloor\-wheel\-lathe/?$ /en-us/underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^cnc\-tandem\-underfloor\-wheel\-lathe/?$ /tandem-underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^de\-de/cnc\-tandem\-underfloor\-wheel\-lathe/?$ /de-de/tandem-underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^fr\-fr/cnc\-tandem\-underfloor\-wheel\-lathe/?$ /fr-fr/tandem-underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^it\-it/cnc\-tandem\-underfloor\-wheel\-lathe/?$ /it-it/tandem-underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^nl\-nl/cnc\-tandem\-underfloor\-wheel\-lathe/?$ /nl-nl/tandem-underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^en\-us/cnc\-tandem\-underfloor\-wheel\-lathe/?$ /en-us/tandem-underfloor-wheel-lathe/ [R=301,L,NC]
RewriteRule ^cnc\-portal\-wheel\-lathe/?$ /portal-wheel-lathe/ [R=301,L,NC]
RewriteRule ^de\-de/cnc\-portal\-wheel\-lathe/?$ /de-de/portal-wheel-lathe/ [R=301,L,NC]
RewriteRule ^fr\-fr/cnc\-portal\-wheel\-lathe/?$ /fr-fr/portal-wheel-lathe/ [R=301,L,NC]
RewriteRule ^it\-it/cnc\-portal\-wheel\-lathe/?$ /it-it/portal-wheel-lathe/ [R=301,L,NC]
RewriteRule ^nl\-nl/cnc\-portal\-wheel\-lathe/?$ /nl-nl/portal-wheel-lathe/ [R=301,L,NC]
RewriteRule ^en\-us/cnc\-portal\-wheel\-lathe/?$ /en-us/portal-wheel-lathe/ [R=301,L,NC]
RewriteRule ^cnc\-vertical\-turning\-boring\-machine/?$ /vertical-turning-boring-machine/ [R=301,L,NC]
RewriteRule ^de\-de/cnc\-vertical\-turning\-boring\-machine/?$ /de-de/vertical-turning-boring-machine/ [R=301,L,NC]
RewriteRule ^fr\-fr/cnc\-vertical\-turning\-boring\-machine/?$ /fr-fr/vertical-turning-boring-machine/ [R=301,L,NC]
RewriteRule ^it\-it/cnc\-vertical\-turning\-boring\-machine/?$ /it-it/vertical-turning-boring-machine/ [R=301,L,NC]
RewriteRule ^nl\-nl/cnc\-vertical\-turning\-boring\-machine/?$ /nl-nl/vertical-turning-boring-machine/ [R=301,L,NC]
RewriteRule ^en\-us/cnc\-vertical\-turning\-boring\-machine/?$ /en-us/vertical-turning-boring-machine/ [R=301,L,NC]
RewriteRule ^cnc\-axle\-journal\-turning\-burnishing\-lathe/?$ /axle-journal-turning-burnishing-lathe/ [R=301,L,NC]
RewriteRule ^de\-de/cnc\-axle\-journal\-turning\-burnishing\-lathe/?$ /de-de/axle-journal-turning-burnishing-lathe/ [R=301,L,NC]
RewriteRule ^fr\-fr/cnc\-axle\-journal\-turning\-burnishing\-lathe/?$ /fr-fr/axle-journal-turning-burnishing-lathe/ [R=301,L,NC]
RewriteRule ^it\-it/cnc\-axle\-journal\-turning\-burnishing\-lathe/?$ /it-it/axle-journal-turning-burnishing-lathe/ [R=301,L,NC]
RewriteRule ^nl\-nl/cnc\-axle\-journal\-turning\-burnishing\-lathe/?$ /nl-nl/axle-journal-turning-burnishing-lathe/ [R=301,L,NC]
RewriteRule ^en\-us/cnc\-axle\-journal\-turning\-burnishing\-lathe/?$ /en-us/axle-journal-turning-burnishing-lathe/ [R=301,L,NC]
RewriteRule ^multipurpose\-armature\-machine/?$ /multi-purpose-armature-machine/ [R=301,L,NC]
RewriteRule ^de\-de/multipurpose\-armature\-machine/?$ /de-de/multi-purpose-armature-machine/ [R=301,L,NC]
RewriteRule ^fr\-fr/multipurpose\-armature\-machine/?$ /fr-fr/multi-purpose-armature-machine/ [R=301,L,NC]
RewriteRule ^it\-it/multipurpose\-armature\-machine/?$ /it-it/multi-purpose-armature-machine/ [R=301,L,NC]
RewriteRule ^nl\-nl/multipurpose\-armature\-machine/?$ /nl-nl/multi-purpose-armature-machine/ [R=301,L,NC]
RewriteRule ^en\-us/multipurpose\-armature\-machine/?$ /en-us/multi-purpose-armature-machine/ [R=301,L,NC]
RewriteRule ^wheel\-press/?$ /wheel-presses/ [R=301,L,NC]
RewriteRule ^de\-de/wheel\-press/?$ /de-de/wheel-presses/ [R=301,L,NC]
RewriteRule ^fr\-fr/wheel\-press/?$ /fr-fr/wheel-presses/ [R=301,L,NC]
RewriteRule ^it\-it/wheel\-press/?$ /it-it/wheel-presses/ [R=301,L,NC]
RewriteRule ^nl\-nl/wheel\-press/?$ /nl-nl/wheel-presses/ [R=301,L,NC]
RewriteRule ^en\-us/wheel\-press/?$ /en-us/wheel-presses/ [R=301,L,NC]
RewriteRule ^epc\-project/?$ /turnkey-project/ [R=301,L,NC]
RewriteRule ^de\-de/epc\-project/?$ /de-de/turnkey-project/ [R=301,L,NC]
RewriteRule ^fr\-fr/epc\-project/?$ /fr-fr/turnkey-project/ [R=301,L,NC]
RewriteRule ^it\-it/epc\-project/?$ /it-it/turnkey-project/ [R=301,L,NC]
RewriteRule ^nl\-nl/epc\-project/?$ /nl-nl/turnkey-project/ [R=301,L,NC]
RewriteRule ^en\-us/epc\-project/?$ /en-us/turnkey-project/ [R=301,L,NC]
RewriteRule ^maintainance/?$ /maintenance/ [R=301,L,NC]
RewriteRule ^de\-de/maintainance/?$ /de-de/maintenance/ [R=301,L,NC]
RewriteRule ^fr\-fr/maintainance/?$ /fr-fr/maintenance/ [R=301,L,NC]
RewriteRule ^it\-it/maintainance/?$ /it-it/maintenance/ [R=301,L,NC]
RewriteRule ^nl\-nl/maintainance/?$ /nl-nl/maintenance/ [R=301,L,NC]
RewriteRule ^en\-us/maintainance/?$ /en-us/maintenance/ [R=301,L,NC]
RewriteRule ^installation\-and\-commissioning/?$ /installation-commissioning/ [R=301,L,NC]
RewriteRule ^de\-de/installation\-and\-commissioning/?$ /de-de/installation-commissioning/ [R=301,L,NC]
RewriteRule ^fr\-fr/installation\-and\-commissioning/?$ /fr-fr/installation-commissioning/ [R=301,L,NC]
RewriteRule ^it\-it/installation\-and\-commissioning/?$ /it-it/installation-commissioning/ [R=301,L,NC]
RewriteRule ^nl\-nl/installation\-and\-commissioning/?$ /nl-nl/installation-commissioning/ [R=301,L,NC]
RewriteRule ^en\-us/installation\-and\-commissioning/?$ /en-us/installation-commissioning/ [R=301,L,NC]
RewriteRule ^wheel\-shop\-automation/?$ /turnkey-project/wheel-shops/ [R=301,L,NC]
RewriteRule ^de\-de/wheel\-shop\-automation/?$ /de-de/turnkey-project/wheel-shops/ [R=301,L,NC]
RewriteRule ^fr\-fr/wheel\-shop\-automation/?$ /fr-fr/turnkey-project/wheel-shops/ [R=301,L,NC]
RewriteRule ^it\-it/wheel\-shop\-automation/?$ /it-it/turnkey-project/wheel-shops/ [R=301,L,NC]
RewriteRule ^nl\-nl/wheel\-shop\-automation/?$ /nl-nl/turnkey-project/wheel-shops/ [R=301,L,NC]
RewriteRule ^en\-us/wheel\-shop\-automation/?$ /en-us/turnkey-project/wheel-shops/ [R=301,L,NC]

# 3. Never expose /index.html – redirect to the clean directory URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# 4. Add the trailing slash to directory URLs (avoids duplicate URLs).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# Tighten connect-src/form-action to your form provider once chosen (see docs/forms-integration.md).
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self' https:; form-action 'self' https:; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com; media-src 'self'; base-uri 'self'; object-src 'none'"
<FilesMatch "\.(css|js|woff2|jpg|jpeg|png|svg|webp|pdf)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|json|xml|txt)$">
Header set Cache-Control "public, max-age=600, must-revalidate"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
